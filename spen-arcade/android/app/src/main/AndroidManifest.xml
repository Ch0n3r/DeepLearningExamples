<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- S Pen Remote требует объявить фичу; required=false, чтобы приложение
         ставилось и на устройства без Air Actions (там работает hover-наклон). -->
    <uses-feature android:name="com.samsung.feature.spen_remote" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />

    <!-- SDK биндится к сервису пакета S Pen Framework явным ComponentName.
         На Android 11+ package visibility скрывает чужие пакеты, и без этого
         блока bindService() молча не находит сервис. -->
    <queries>
        <package android:name="com.samsung.android.service.aircommand" />
    </queries>

    <application
        android:label="S Pen Arcade"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.SPenArcade">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
